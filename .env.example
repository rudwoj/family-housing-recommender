# ============================================================
# family-housing-recommender · 외부 데이터 연동 환경변수
# ------------------------------------------------------------
# 사용법:
#   1) 이 파일을 복사해 .env 로 저장한다 (.env 는 .gitignore 에 등록되어 커밋되지 않음)
#   2) 아래 값을 실제 발급받은 키로 채운다
#   3) python scripts/check_api_access.py 로 어떤 데이터가 실제로 조회되는지 먼저 확인한다
# ============================================================

# --- 공공데이터포털 (data.go.kr) ---------------------------------------------
# https://www.data.go.kr 에서 "국토교통부_아파트 전월세 실거래가 자료" 를
# 활용신청한 뒤 발급되는 서비스키.
# 포털은 키를 Encoding/Decoding 두 형태로 보여주는데, 어느 쪽을 넣어도 되도록
# 코드에서 자동으로 보정한다.
#
# 주의: 이 API는 본질적으로 "가격(보증금/월세)" 실거래 데이터셋이다. 이 프로젝트는
# 가격 컬럼을 절대 쓰지 않으므로(src/schema.py assert_no_price_columns), 여기서는
# 면적/층/건축년도/주소 같은 물리적 속성만 뽑아 쓰고 금액 필드는 전부 버린다.
DATA_GO_KR_SERVICE_KEY=

# data.go.kr 는 API 엔드포인트를 종종 개편한다. 아래 기본값은 실제 호출로 존재를
# 확인했지만(2026-09 기준), 혹시 NO_OPENAPI_SERVICE_ERROR 가 뜨면 마이페이지 >
# 활용신청 현황 > 해당 API 상세 페이지의 "요청 URL" 예제로 교체할 것. 비워두면 기본값 사용.
DATA_GO_KR_APT_RENT_ENDPOINT=

# --- 카카오 디벨로퍼스 (developers.kakao.com) --------------------------------
# 내 애플리케이션 > 앱 키 > "REST API 키" 값 (JavaScript 키 아님)
KAKAO_REST_API_KEY=

# 지도를 카카오맵으로 렌더링할 때 쓰는 "JavaScript 키" (REST API 키와 다름).
# 내 애플리케이션 > 앱 키 > JavaScript 키
# 추가로 [플랫폼 > Web > 사이트 도메인]에 아래 주소를 등록해야 SDK 가 로드된다.
#   http://localhost:8520
#   https://family-housing-recommender.streamlit.app
# 비워두면 기존 Plotly(OpenStreetMap 계열) 지도로 자동 폴백한다.
KAKAO_JAVASCRIPT_KEY=

# --- 수집 범위 설정 (선택, 비워두면 기본값 사용) ------------------------------
# 수집할 시군구 법정동코드 5자리(LAWD_CD), 콤마로 구분 (기본값: 서울 10개 구 — 기존 mock 데이터와 동일 권역)
TARGET_SIGUNGU_CODES=11680,11710,11440,11200,11350,11470,11560,11380,11590,11215

# 조회할 계약년월 6자리 (YYYYMM). 비워두면 지난달로 자동 설정됨
TARGET_DEAL_YM=

# 시군구 1곳당 최대 수집 건수 (0 = 기본 20건). 지오코딩·지하철역 조회가 병렬로 돌아
# 매물 1건당 약 12ms 든다 — 10개 구 기준 100건이면 약 1,000건/14초, 200건이면 2,000건/24초.
# 결과는 6시간 캐시되므로 첫 로딩에서만 이 시간이 든다.
MAX_COMPLEXES_PER_SIGUNGU=100

# 외부 API 연속 호출 사이 대기시간(초) — 과호출/차단 방지용
REQUEST_INTERVAL_SEC=0.2

# ---------------------------------------------------------------------------
# TMap 보행자 경로안내 (https://openapi.sk.com)  — 도보 전용
# ---------------------------------------------------------------------------
# 로그인 > 대시보드 > 앱 생성 후,
# PRODUCTS > 교통/위치 > TMAP > "API 사용 요금" > 무료체험 Free > [사용하기]
# 앱에 상품을 붙이지 않으면 앱키가 있어도 403 INVALID_API_KEY 가 난다.
# 상품 등록 후 게이트웨이 반영에 20초가량 걸린다.
# 도보는 카카오·네이버 모두 길찾기가 없어 TMap 이 사실상 유일하다.
# Free 한도는 보행자 경로안내 1,000건/일, 서비스 지역은 서울·수도권·6대광역시·제주 등.
# 없으면 도보는 직선거리 × 우회계수 추정으로 동작한다.
#   배포본: Settings > Secrets 에 최상위 키로  TMAP_APP_KEY = "..."
TMAP_APP_KEY=
